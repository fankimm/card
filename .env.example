API_ENDPOINT = google/spread/sheet/apps/script/api
# 문자 수신 로그를 남길 주소. 보통 API_ENDPOINT와 같은 값을 넣는다.
# Apps Script에 type === 'log' 분기를 먼저 추가한 뒤에 설정할 것 (없으면 로그를 보내지 않는다)
LOG_ENDPOINT = google/spread/sheet/apps/script/api

# 조회를 빠르게: 결제 내역 탭의 CSV 주소. 채우면 조회만 이쪽으로 읽고(1초 안팎),
# 실패하면 API_ENDPOINT(Apps Script, 7초대)로 물러난다. 제외 탭은 gid만 바꿔 같은 주소로 읽는다.
# 기록(문자 추가·제외 토글·로그)은 계속 API_ENDPOINT 로 간다.
#   https://docs.google.com/spreadsheets/d/<시트ID>/export?format=csv&gid=0
# 시트가 "링크가 있는 모든 사용자: 뷰어"로 공유돼 있어야 한다.
SHEET_CSV_URL =

# 문자 수신 웹훅(/api/hello) 인증. 채우면 그때부터 검사한다.
# 문자 전달 앱의 URL을 ?key=... 로 먼저 고친 뒤에 채울 것 (안 그러면 수신이 끊긴다).
# 헤더 x-ingest-secret 로도 받는다.
INGEST_SECRET =

# 좌석 자동 예약(/api/pick-seat). 크론에서 x-cron-secret 헤더나 ?key= 로 보낸다.
CRON_SECRET =
PICKSEAT_NAME =
PICKSEAT_PASSCODE =
PICKSEAT_USER_ID =
PICKSEAT_SEAT_ID =

NEXT_PUBLIC_ADSENSE_SLOT =
NEXT_PUBLIC_ADSENSE_CLIENT =

# 세션 인증. 채우면 데이터 API가 쿼리 파라미터 대신 서명 쿠키만 믿는다.
# 켜는 순간 기존 사용자는 한 번 다시 로그인해야 한다(앱이 자동으로 로그인 화면으로 보낸다).
#   openssl rand -base64 32
SESSION_SECRET =

# 급여명세서 복호화 API(/api/pay)를 부를 수 있는 출처. 콤마 구분.
# 비워두면 CORS 헤더를 안 붙여 같은 출처에서만 쓸 수 있다.
PAY_ALLOWED_ORIGINS =
